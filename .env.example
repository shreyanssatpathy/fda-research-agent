# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Only SQL generation needs this. The loader, the SQL guard, and eval scoring
# all run offline without it.

ANTHROPIC_API_KEY=

# Required only if your key is identity-linked (the API returns
# "anthropic-workspace-id is required" without it). Find it in the Anthropic
# Console URL when a workspace is selected. Not a secret.
ANTHROPIC_WORKSPACE_ID=
